{
	"name": "fsa-emitter",
	"version": "2.0.2",
	"description": "Emitter using Flux Standard Action",
	"keywords": [
		"fsa",
		"flux-standard-action",
		"emitter",
		"eventemitter3",
		"utility"
	],
	"homepage": "https://github.com/cyberuni/fsa-emitter",
	"bugs": {
		"url": "https://github.com/cyberuni/fsa-emitter/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberuni/fsa-emitter.git"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./esm/index.d.ts",
			"default": "./esm/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"esm",
		"!**/*.{accept,integrate,spec,system,test,unit}.*"
	],
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch",
		"clean": "rimraf coverage esm *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"nuke": "pnpm clean && rimraf node_modules",
		"test": "vitest run",
		"typecheck": "tsc",
		"verify": "npm-run-all clean -p build typecheck coverage depcheck",
		"watch": "vitest",
		"w": "pnpm watch"
	},
	"dependencies": {
		"@types/fbemitter": "^2.0.32",
		"fbemitter": "^3.0.0",
		"flux-standard-action": "^2.1.2",
		"tersify": "^4.0.6",
		"type-plus": "8.0.0-beta.10"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@vitest/coverage-v8": "^4.1.11",
		"assertron": "^11.6.0",
		"depcheck": "^1.4.7",
		"npm-run-all2": "^9.0.0",
		"rimraf": "^6.0.1",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24"
	}
}
